### Paths are for Mac/Linux. On Windows, confirm separators.
GITHUB_DIR=/Users/roy/Github-Repos/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=ShakespeareDataHandler
MODULE_FILE=shakespeare_data_handler.py

TMP_DIR=edgefl/tmp_dir/
# Operator2 listens on the LAN address. 127.0.0.1:32248 refuses the TCP connection.
EXTERNAL_IP="127.0.0.1:32249"
EXTERNAL_TCP_IP_PORT="127.0.0.1:32248"

LOGICAL_DATABASE=mydb
TRAIN_TABLE=shakespeare_train
TEST_TABLE=shakespeare_test

DATA_EPOCH_START=2026-10-01T17:00:00Z
ROUND_DURATION_SECONDS=60
QUERY_GRACE_SECONDS=2
SEQ_LEN=40
TRAIN_EPOCHS=15
TRAIN_HISTORY_ROUNDS=12
BATCH_SIZE=32
GEN_LEN=40
INFERENCE_TEMPERATURE=0.7
INFERENCE_TOP_K=12

SERVER_TYPE=node

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="False"
EDGELAKE_DOCKER_CONTAINER_NAME="operator2"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"
