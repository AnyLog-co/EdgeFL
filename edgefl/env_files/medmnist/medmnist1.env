### Paths are for Mac/Linux. On Windows, confirm separators.
GITHUB_DIR=/Users/roy/Github-Repos/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=MedMNISTDataHandler
MODULE_FILE=medmnist_data_handler.py

TMP_DIR=edgefl/tmp_dir/
# Operator1 EdgeLake REST and TCP. This REST address is what the publisher receives.
EXTERNAL_IP="127.0.0.1:32149"
EXTERNAL_TCP_IP_PORT="127.0.0.1:32148"

LOGICAL_DATABASE=mydb
TRAIN_TABLE=medmnist_train
TEST_TABLE=medmnist_test
# PNGs written by publish_medmnist_info.py. AnyLog stores the filename only.
IMAGE_ROOT_DIR=edgefl/data/medmnist/published_images

# Training selects WHERE round_number = N. These retries cover the short gap
# while the publisher is still inserting that round.
QUERY_RETRIES=15
QUERY_RETRY_SECONDS=2

# Local work per round. 20 epochs over this node's images (about 512 new
# slides per round with the default 3-operator publisher, plus the previous
# TRAIN_HISTORY_ROUNDS) is what makes a few federated rounds actually learn.
TRAIN_EPOCHS=20
TRAIN_HISTORY_ROUNDS=4
EVAL_HISTORY_ROUNDS=4
BATCH_SIZE=32
LEARNING_RATE=0.001

SERVER_TYPE=node

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="False"
EDGELAKE_DOCKER_CONTAINER_NAME="operator1"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"
